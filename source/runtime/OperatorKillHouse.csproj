<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Version>0.1.22</Version>
    <OperatorLoader Condition="'$(OperatorLoader)' == ''">BepInEx</OperatorLoader>
    <AssemblyName Condition="'$(OperatorLoader)' != 'MelonLoader'">OperatorKillHouse</AssemblyName>
    <AssemblyName Condition="'$(OperatorLoader)' == 'MelonLoader'">OperatorKillHouse.MelonLoader</AssemblyName>
    <RootNamespace>OperatorKillHouse</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <KillHouseSourceRoot Condition="'$(KillHouseSourceRoot)' == ''">$(MSBuildThisFileDirectory)..</KillHouseSourceRoot>
    <OperatorModApiRoot Condition="'$(OperatorModApiRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Operator_GroceryStore_Mod\_public_release\operator-mod-api\src\OperatorModAPI\OperatorModAPI.csproj')">$(MSBuildThisFileDirectory)..\..\..\Operator_GroceryStore_Mod\_public_release\operator-mod-api</OperatorModApiRoot>
    <OperatorModApiRoot Condition="'$(OperatorModApiRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\Operator_GroceryStore_Mod\_public_release\operator-mod-api\src\OperatorModAPI\OperatorModAPI.csproj')">$(MSBuildThisFileDirectory)..\..\..\..\..\Operator_GroceryStore_Mod\_public_release\operator-mod-api</OperatorModApiRoot>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Operator_GroceryStore_Mod\_dependencies\MelonLoader\v0.7.3\MelonLoader\net6\MelonLoader.dll')">$(MSBuildThisFileDirectory)..\..\..\Operator_GroceryStore_Mod\_dependencies\MelonLoader\v0.7.3\MelonLoader\net6</MelonLoaderDir>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\..\Operator_GroceryStore_Mod\_dependencies\MelonLoader\v0.7.3\MelonLoader\net6\MelonLoader.dll')">$(MSBuildThisFileDirectory)..\..\..\..\..\Operator_GroceryStore_Mod\_dependencies\MelonLoader\v0.7.3\MelonLoader\net6</MelonLoaderDir>
    <OperatorInteropDir Condition="'$(OperatorLoader)' != 'MelonLoader'">$(OperatorGameDir)\BepInEx\interop</OperatorInteropDir>
    <OperatorInteropDir Condition="'$(OperatorLoader)' == 'MelonLoader'">$(OperatorGameDir)\MelonLoader\Il2CppAssemblies</OperatorInteropDir>
    <DefineConstants Condition="'$(OperatorLoader)' == 'MelonLoader'">$(DefineConstants);MELONLOADER</DefineConstants>
    <IntermediateOutputPath>obj\$(OperatorLoader)\$(Configuration)\</IntermediateOutputPath>
    <OutputPath Condition="'$(OperatorLoader)' == 'MelonLoader'">bin\$(Configuration)\MelonLoader\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OperatorKillHousePlugin.cs" />
    <Compile Include="MelonAssemblyInfo.cs" />
    <EmbeddedResource Include="$(KillHouseSourceRoot)\unity_project\Assets\VektorKillHouse\Native\Residential\SourceMaterials\*.json">
      <LogicalName>OperatorKillHouse.NativeMaterials.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(KillHouseSourceRoot)\unity_project\Assets\VektorKillHouse\Native\ResidentialComplete\SourceMaterials\*.json">
      <LogicalName>OperatorKillHouse.NativeMaterials.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(KillHouseSourceRoot)\unity_project\Assets\VektorKillHouse\Native\ResidentialHierarchy\SourceMaterials\*.json">
      <LogicalName>OperatorKillHouse.NativeMaterials.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(KillHouseSourceRoot)\unity_project\Assets\VektorKillHouse\Native\WarehousePvp\SourceMaterials\*.json">
      <LogicalName>OperatorKillHouse.NativeMaterials.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="$(OperatorModApiRoot)\src\OperatorModAPI\OperatorModAPI.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="$(OperatorModApiRoot)\src\OperatorModAPI.MelonLoader\OperatorModAPI.MelonLoader.csproj" Condition="'$(OperatorLoader)' == 'MelonLoader'"><Private>false</Private></ProjectReference>
    <Reference Include="BepInEx.Core" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorGameDir)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorGameDir)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorGameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorGameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(MelonLoaderDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(OperatorInteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(OperatorInteropDir)\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem.Core"><HintPath>$(OperatorInteropDir)\Il2CppSystem.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AstarPathfindingProject" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorInteropDir)\AstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppAstarPathfindingProject" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Il2CppAstarPathfindingProject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(OperatorInteropDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(OperatorInteropDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppMirror" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Il2CppMirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PackageTools" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorInteropDir)\PackageTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppPackageTools" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Il2CppPackageTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Drawing" Condition="'$(OperatorLoader)' != 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Drawing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppDrawing" Condition="'$(OperatorLoader)' == 'MelonLoader'"><HintPath>$(OperatorInteropDir)\Il2CppDrawing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"><HintPath>$(OperatorInteropDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(OperatorInteropDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(OperatorInteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(OperatorInteropDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(OperatorInteropDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(OperatorInteropDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(OperatorInteropDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireResolvedLoaderInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(OperatorModApiRoot)' == ''" Text="Operator Mod API root could not be resolved from the private or public Kill House source layout. Set OperatorModApiRoot explicitly." />
    <Error Condition="'$(OperatorModApiRoot)' != '' and !Exists('$(OperatorModApiRoot)\src\OperatorModAPI\OperatorModAPI.csproj')" Text="Operator Mod API Core project is missing under OperatorModApiRoot=$(OperatorModApiRoot)." />
    <Error Condition="'$(OperatorLoader)' == 'MelonLoader' and '$(OperatorModApiRoot)' != '' and !Exists('$(OperatorModApiRoot)\src\OperatorModAPI.MelonLoader\OperatorModAPI.MelonLoader.csproj')" Text="Operator Mod API MelonLoader adapter project is missing under OperatorModApiRoot=$(OperatorModApiRoot)." />
    <Error Condition="'$(OperatorLoader)' == 'MelonLoader' and '$(MelonLoaderDir)' == ''" Text="MelonLoader v0.7.3 could not be resolved from the private or public Kill House source layout. Set MelonLoaderDir explicitly." />
    <Error Condition="'$(OperatorLoader)' == 'MelonLoader' and '$(MelonLoaderDir)' != '' and !Exists('$(MelonLoaderDir)\MelonLoader.dll')" Text="MelonLoader.dll is missing under MelonLoaderDir=$(MelonLoaderDir)." />
  </Target>
  <Target Name="RequireAuthorizedNativeMaterialProfiles" BeforeTargets="CoreCompile"
          Condition="'$(AllowMissingNativeMaterialProfiles)' != 'true'">
    <ItemGroup>
      <_NativeMaterialProfiles Include="$(KillHouseSourceRoot)\unity_project\Assets\VektorKillHouse\Native\**\SourceMaterials\*.json" />
    </ItemGroup>
    <Error Condition="'@(_NativeMaterialProfiles)' == ''"
           Text="Authorized OPERATOR native material profile inputs are missing. Populate them from the exact installed game, or set AllowMissingNativeMaterialProfiles=true only for a compile-only source check." />
  </Target>
</Project>
